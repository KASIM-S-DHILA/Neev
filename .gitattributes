# Normalize line endings in the repository. The index stores LF; Windows
# checkouts get CRLF via core.autocrlf, but the committed content is stable
# regardless of who commits it.
* text=auto eol=lf

*.py    text eol=lf
*.pyi   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.cjs   text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.sql   text eol=lf
*.lock  text eol=lf

# Binary assets must never be line-ending translated or diffed as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.mp4   binary
*.mp3   binary
*.wav   binary
*.sqlite3 binary
*.sqlite3-wal binary
*.sqlite3-shm binary
*.ttf   binary
*.woff  binary
*.woff2 binary
*.lnk   binary

# Windows shortcuts are per-machine artifacts, not portable project files.
*.lnk   linguist-vendored